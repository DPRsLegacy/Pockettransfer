@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<div class="hero">
    <h1>Pockettransfer</h1>
    <p class="lead">Your personal Pokémon Bank — view stored Pokémon in the browser, deposit and withdraw from 3DS or Switch.</p>
    <div class="hero-actions">
        <a class="btn btn-primary btn-lg" asp-page="/Account/Login">Log in</a>
        <a class="btn btn-outline-light btn-lg" asp-page="/Account/Register">Create account</a>
    </div>
</div>
<section class="feature-grid">
    <div class="feature-card">
        <h3>Web bank</h3>
        <p>Log in with username and password on PC or phone. Browse 32 boxes, search, and read PKHeX legality reports.</p>
    </div>
    <div class="feature-card">
        <h3>Console transfer</h3>
        <p>Pair your 3DS or Switch, upload a save, deposit or withdraw — PKHeX handles conversion on the server.</p>
    </div>
    <div class="feature-card">
        <h3>Secure storage</h3>
        <p>Pokémon are stored in PostgreSQL on your server. Saves only stay in memory during a session.</p>
    </div>
</section>
