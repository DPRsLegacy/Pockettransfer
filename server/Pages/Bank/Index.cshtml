@page "/Bank"
@model Pockettransfer.Server.Pages.Bank.IndexModel
@{
    ViewData["Title"] = "My Bank";
    var active = Model.Boxes.ElementAtOrDefault(Model.ActiveBox);
}
<div class="bank-header">
    <div>
        <h1>My Bank</h1>
        <p class="bank-stats">@Model.TotalPokemon Pokémon · @Model.FilledBoxes / @Model.Boxes.Count boxes used</p>
    </div>
    <form class="bank-search" method="get">
        <input type="search" name="q" value="@Model.Query" placeholder="Search nickname, species, OT…" class="form-control" />
        @if (Model.Query is null)
        {
            <input type="hidden" name="box" value="@Model.ActiveBox" />
        }
        <button class="btn btn-outline-light" type="submit">Search</button>
    </form>
</div>

@if (Model.Query is not null)
{
    <section class="search-results">
        <h2>Results for “@Model.Query”</h2>
        @if (Model.SearchResults.Count == 0)
        {
            <p class="text-muted">No Pokémon matched.</p>
        }
        else
        {
            <div class="pokemon-list">
                @foreach (var p in Model.SearchResults)
                {
                    <a class="pokemon-card @(p.IsLegal ? "legal" : "illegal")" asp-page="/Bank/Slot" asp-route-id="@p.Id">
                        <img class="pokemon-sprite" src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/@(p.Species).png" alt="" loading="lazy" />
                        <div class="pokemon-card-body">
                            <span class="pokemon-card-name @(p.IsShiny ? "shiny" : "")">@p.Nickname</span>
                            <span class="pokemon-card-meta">@p.SpeciesName · Lv @p.Level · Box @(p.BoxIndex + 1)</span>
                        </div>
                    </a>
                }
            </div>
        }
        <p><a asp-page="/Bank/Index" asp-route-box="@Model.ActiveBox">Clear search</a></p>
    </section>
}
else if (active is not null)
{
    <nav class="box-tabs" aria-label="Bank boxes">
        @foreach (var b in Model.Boxes)
        {
            <a class="box-tab @(b.Index == Model.ActiveBox ? "active" : "") @(b.Slots.Count > 0 ? "has-mons" : "")"
               asp-page="/Bank/Index" asp-route-box="@b.Index">@b.Name</a>
        }
    </nav>

    <section class="bank-box">
        <h2 class="visually-hidden">@active.Name</h2>
        <div class="slot-grid">
            @for (var i = 0; i < 30; i++)
            {
                var slot = active.Slots.FirstOrDefault(s => s.Slot == i);
                if (slot is null)
                {
                    <div class="slot empty" aria-label="Empty slot @i">·</div>
                }
                else
                {
                    <a class="slot @(slot.IsLegal ? "legal" : "illegal") @(slot.IsShiny ? "shiny" : "")"
                       asp-page="/Bank/Slot" asp-route-id="@slot.Id"
                       title="@slot.SpeciesName">
                        <img class="slot-sprite" src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/@(slot.Species).png" alt="" loading="lazy" />
                        <span class="slot-name">@slot.Nickname</span>
                        <span class="slot-meta">Lv @slot.Level</span>
                    </a>
                }
            }
        </div>
    </section>
}
