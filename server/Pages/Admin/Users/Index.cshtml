@page
@model Pockettransfer.Server.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}
<div class="pt-panel">
    <div class="bank-header">
        <div>
            <nav class="breadcrumb-nav mb-1"><a asp-page="/Admin/Index">← Admin</a></nav>
            <h1>Users</h1>
            <p class="bank-stats">@Model.Total account(s)</p>
        </div>
        <form class="bank-search" method="get">
            <input type="search" name="q" value="@Model.Query" placeholder="Search username…" class="form-control" />
            <button class="btn btn-primary" type="submit">Search</button>
        </form>
    </div>
    @if (Model.Users.Count == 0)
    {
        <p class="text-muted mb-0">No users matched.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="pt-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Pokémon</th>
                        <th>Devices</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <a asp-page="/Admin/Users/Details" asp-route-id="@u.Id">@u.Username</a>
                            @if (u.IsAdmin) { <span class="admin-badge">admin</span> }
                        </td>
                        <td>@u.PokemonCount</td>
                        <td>@u.DeviceCount</td>
                        <td>@u.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd")</td>
                        <td class="admin-row-actions">
                            <a asp-page="/Admin/Users/Bank" asp-route-id="@u.Id">Bank</a>
                            <a asp-page="/Admin/Users/Details" asp-route-id="@u.Id">Manage</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="admin-pager" aria-label="Pages">
                @if (Model.PageNumber > 1)
                {
                    <a asp-page="/Admin/Users/Index" asp-route-q="@Model.Query" asp-route-p="@(Model.PageNumber - 1)">Previous</a>
                }
                <span>Page @Model.PageNumber / @Model.TotalPages</span>
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-page="/Admin/Users/Index" asp-route-q="@Model.Query" asp-route-p="@(Model.PageNumber + 1)">Next</a>
                }
            </nav>
        }
    }
</div>
