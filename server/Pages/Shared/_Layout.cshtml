@inject AccountService Accounts
@{
    var path = ViewContext.HttpContext.Request.Path.Value ?? "";
    var isAdmin = User.Identity?.IsAuthenticated == true
        && await Accounts.IsAdminAsync(User, ViewContext.HttpContext.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pocket Transfer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pockettransfer.Server.styles.css" asp-append-version="true" />
</head>
<body class="pt-app">
    <header class="pt-header">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container pt-main">
                <a class="navbar-brand" asp-page="/Index">
                    <span class="pt-logo" aria-hidden="true"></span>
                    Pocket Transfer
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ptNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="ptNav">
                    <ul class="navbar-nav flex-grow-1 ms-sm-3">
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Bank", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Bank/Index">My Bank</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Saves", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Saves/Index">Saves</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWith("/Devices", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Devices/Index">Devices</a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(path.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Admin/Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="navbar-text me-2">@User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-light" type="submit">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Log in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container pt-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="pt-footer">
        Pocket Transfer uses PKHeX.Core (GPL-3.0) for legality and save writes.
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
