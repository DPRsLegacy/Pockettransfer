@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="pt-panel">
    <h1 class="text-danger">Something went wrong</h1>
    <p class="pt-panel-sub">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    @if (Model.ShowDetails && Model.ExceptionMessage is not null)
    {
        <pre class="legality">@Model.ExceptionMessage</pre>
    }
    else
    {
        <p class="text-muted mb-0">
            Check container logs: <code>docker compose logs web --tail=80</code>.
            For on-page details, set <code>PT_DETAILED_ERRORS=true</code> on the web service and restart.
        </p>
    }
</div>
