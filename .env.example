BANK_DOMAIN=pockettransfer.net
POSTGRES_DB=pockettransfer
POSTGRES_USER=pockettransfer
POSTGRES_PASSWORD=change-me-to-a-long-secret

# Optional. Comma-separated usernames always granted admin on startup.
# If unset, the oldest account becomes admin.
PT_ADMIN_USERNAMES=

# Proxmox Docker LXC: deploy/proxmox/README.md
# TLS via Nginx Proxy Manager: deploy/nginx-proxy-manager.md (do NOT use --profile tls)
# Start stack: ./deploy/proxmox/up.sh
